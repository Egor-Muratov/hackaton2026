# Скопируйте в .env (cp .env.example .env) и поменяйте пароли. .env в git не коммитится.
# На VM bootstrap-vm.sh создаёт .env сам со случайными паролями. В CI можно передать файлом (переменная ENV_FILE).

# --- compose ---
COMPOSE_PROJECT_NAME=forecast
HTTP_PORT=80
# Каталог с данными на хосте (монтируется в api и ml как /data:ro). Путь абсолютный или относительно infra/.
DATA_HOST_DIR=../data

# --- БД (Postgres 16) ---
POSTGRES_PASSWORD=change-me-postgres
# Пароли ролей app (API) и ml_reader (ML); на пустом volume выставляются автоматически, иначе: make db-passwords
APP_DB_PASSWORD=change-me-app
ML_DB_PASSWORD=change-me-ml

# --- образы ---
# registry-путь: REGISTRY_PREFIX=registry.gitlab.example/group/forecast-template ; иначе локальные имена forecast/*
REGISTRY_PREFIX=forecast
IMAGE_TAG=local
# Версии базовых образов НЕ задаются здесь: единственный источник — infra/images.lock (make check-images).

# --- сборка: прокси / зеркала / офлайн ---
# Прокси ТОЛЬКО для docker build (в образ не попадает как ENV, если Dockerfile не делает ENV сам).
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,db,api,ml,frontend
# host, если прокси слушает на 127.0.0.1 хоста (иначе из контейнера сборки он не виден)
BUILD_NETWORK=default
# Зеркала (пусто = по умолчанию): https://nexus.local/repository/pypi/simple , .../npm/ , .../nuget/index.json
MIRROR_PIP_INDEX=
MIRROR_NPM_REGISTRY=
MIRROR_NUGET_SOURCE=
# 1 = ставить зависимости только из офлайн-запаса (wheels/nuget/npm в OFFLINE_DIR)
OFFLINE=0
# Каталог запаса: АБСОЛЮТНЫЙ путь (make подставляет <repo>/offline сам, если пусто)
# OFFLINE_DIR=/opt/forecast/offline

# --- деплой (make deploy) ---
VM_HOST=
VM_USER=ubuntu
VM_PORT=22
VM_DIR=/opt/forecast
