  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "antd": "^5.21.0",
    "dayjs": "^1.11.13",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "orval": "^7.3.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0"
  }
}
