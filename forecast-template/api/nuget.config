<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Глобальный конфиг машины указывает на недоступный корпоративный фид: сбрасываем его. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- офлайн-запас: заранее скачанные пакеты (формат global-packages),
         /home/e.muratov/dev/ai-consulting/hackaton/offline/nuget. Если каталога нет, удалите строку
         или запускайте restore с ignore-failed-sources. -->
    <add key="offline" value="../../offline/nuget" />
  </packageSources>
</configuration>
